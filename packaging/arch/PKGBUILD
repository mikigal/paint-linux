# Builds an Arch Linux / CachyOS package from this source tree:
#   cd packaging/arch && makepkg -si
# The package installs the app, its .desktop entry (with the image types it opens), AppStream
# metadata and icon under /usr.

pkgname=paint-for-linux
pkgver=0.1.0
pkgrel=1
pkgdesc="A native Linux take on Windows 11 Paint"
arch=('x86_64' 'aarch64')
url="https://mikigal.pl"
# The project has not chosen a licence yet; set it here once it has.
license=('LicenseRef-unspecified')
depends=('qt6-base' 'qt6-svg' 'libzip' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja')
optdepends=(
    'kimageformats: HEIC, AVIF, JPEG XL, PSD, XCF and more'
    'qt6-imageformats: TIFF and WebP'
    'xdg-desktop-portal: setting the desktop background'
)

_root="$(realpath "$startdir/../..")"

build() {
    cmake -S "$_root" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DPAINT_BUILD_TESTS=OFF \
        -DPAINT_AUTOMATION=OFF \
        -DPAINT_WARNINGS_AS_ERRORS=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
