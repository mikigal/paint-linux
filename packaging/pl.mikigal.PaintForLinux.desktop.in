[Desktop Entry]
Type=Application
Name=@PAINT_DESKTOP_NAME@
GenericName=Image Editor
Comment=Draw, paint and edit pictures
Exec=@PAINT_DESKTOP_EXEC@ %F
Icon=pl.mikigal.PaintForLinux
Terminal=false
StartupNotify=true
StartupWMClass=@PAINT_EXECUTABLE@
Categories=Graphics;2DGraphics;RasterGraphics;
Keywords=paint;draw;drawing;picture;image;editor;mspaint;
MimeType=image/png;image/jpeg;image/bmp;image/gif;image/tiff;image/webp;image/heif;image/heic;image/avif;image/jxl;image/x-icon;image/vnd.microsoft.icon;image/openraster;
